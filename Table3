    for term in focus_terms:
        rows.append({
            "source": source,
            "term": term,
            "present": term in G.nodes(),
            "degree_centrality": deg.get(term, 0),
            "weighted_degree": weighted_degree.get(term, 0),
            "degree": G.degree(term) if term in G.nodes() else 0
        })
    return pd.DataFrame(rows)

