def summarize_network(G, name):
    if G.number_of_nodes() == 0:
        raise ValueError(f"{name}: graph has no nodes")

    deg = nx.degree_centrality(G)
    weighted_degree = dict(G.degree(weight="weight"))

    partition = community_louvain.best_partition(
        G,
        weight="weight",
        resolution=1.0,
        random_state=42
    )

    nx.set_node_attributes(G, partition, "community")
    nx.set_node_attributes(G, deg, "degree_centrality")
    nx.set_node_attributes(G, weighted_degree, "weighted_degree")

    density = nx.density(G)
    clustering = nx.average_clustering(G, weight="weight")

    comm_df = pd.DataFrame({
        "word": list(G.nodes()),
        "community": [partition[n] for n in G.nodes()],
        "degree_centrality": [deg[n] for n in G.nodes()],
        "weighted_degree": [weighted_degree[n] for n in G.nodes()]
    }).sort_values("degree_centrality", ascending=False)

    comm_df.to_csv(f"{OUTDIR}/{name}_node_metrics.csv", index=False)

    top_by_comm = (
        comm_df
        .sort_values(["community", "degree_centrality"], ascending=[True, False])
        .groupby("community")
        .head(10)
    )

    top_by_comm.to_csv(f"{OUTDIR}/{name}_top_words_by_community.csv", index=False)

    summary = {
        "corpus": name,
        "nodes": G.number_of_nodes(),
        "edges": G.number_of_edges(),
        "density": density,
        "average_clustering": clustering,
        "communities": len(set(partition.values()))
    }

    return summary, comm_df, top_by_comm

