def build_symptom_anatomy_matrix(edges_counter, symptoms, anatomy):
    mat = pd.DataFrame(
        0,
        index=symptoms,
        columns=anatomy,
        dtype=int
    )

    for s in symptoms:
        for a in anatomy:
            pair = tuple(sorted([s, a]))
            mat.loc[s, a] = int(edges_counter.get(pair, 0))

    return mat


